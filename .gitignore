.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Secrets and local configuration -- never commit tokens or credentials.
.env
.env.*
!.env.example
*.pem
*.key
.quietcue_env

# Local logs and model weight artifacts (metadata belongs in git, weights do not).
*.log
models/**/*.onnx
models/**/*.tflite
models/**/*.dlc
models/**/*.bin
models/**/*.pt
models/**/*.pb
models/**/*.data
models/**/*.zip
models/converted/qnn_cache*/

# Committed deployment artifacts (small, quantized): the QUAD INT8 DLC and the
# AI Hub w8a8 QDQ ONNX. The large fp32 source weights stay download-only.
!models/converted/yamnet_fp32_selfcontained_quantized.dlc
!models/source/yamnet-onnx-w8a8/yamnet-onnx-w8a8/yamnet.onnx
!models/source/yamnet-onnx-w8a8/yamnet-onnx-w8a8/yamnet.data

# TensorFlow downloads pretrained models here when configured locally.
.model-cache/
.quietcue/

# Android / Gradle
.gradle/
**/build/
local.properties
*.iml
.idea/
captures/
